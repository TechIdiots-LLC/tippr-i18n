#: r2/lib/live_config_admin.py:51
msgid "Who has staff permissions: name:level pairs, comma-separated, where the level is admin, sponsor or employee. Admins can turn on admin mode. You can't remove your own admin permission here."
msgstr "من يملك صلاحيات الطاقم: أزواج name:level مفصولة بفواصل، حيث المستوى هو admin أو sponsor أو employee. يمكن للمديرين تشغيل وضع المدير. لا يمكنك إزالة صلاحية المدير الخاصة بك من هنا."

#: r2/lib/live_config_admin.py:55
msgid "Moderators and staff (employees, and admins for admin mode) need two-factor sign-in turned on (preferences, security) to use their tools; until then they see a notice asking them to. Members without it are unaffected."
msgstr "يحتاج المشرفون والطاقم (الموظفون، والمديرون لوضع المدير) إلى تفعيل تسجيل الدخول بخطوتين (التفضيلات، الأمان) لاستخدام أدواتهم؛ وحتى ذلك الحين يرون إشعارًا يطلب منهم ذلك. الأعضاء الذين لا يملكونه لا يتأثرون."

#: r2/lib/live_config_admin.py:60
msgid "How long a page for logged-out visitors may be kept and served again, in seconds, by nginx's page cache or a CDN in front of the site (logged-in visitors always get fresh pages). Lower it to show changes sooner, or 0 to stop caching pages at once. nginx's page cache has to be on (the installer's TIPPR_PAGE_CACHE_SECONDS) for a value here to do anything there."
msgstr "المدة بالثواني التي يمكن خلالها الاحتفاظ بصفحة للزوار غير المسجلين وتقديمها مجددًا، بواسطة ذاكرة صفحات nginx أو CDN أمام الموقع (الزوار المسجلون يحصلون دائمًا على صفحات حديثة). خفّضها لإظهار التغييرات أسرع، أو 0 لإيقاف تخزين الصفحات فورًا. يجب أن تكون ذاكرة صفحات nginx مفعّلة (TIPPR_PAGE_CACHE_SECONDS في المثبّت) كي يكون للقيمة هنا أي أثر هناك."

#: r2/lib/live_config_admin.py:67
msgid "Accounts with at least this much post karma skip the captcha."
msgstr "الحسابات التي لديها هذا القدر على الأقل من كارما المنشورات تتخطى الكابتشا."

#: r2/lib/live_config_admin.py:69
msgid "Accounts with at least this much comment karma skip the captcha."
msgstr "الحسابات التي لديها هذا القدر على الأقل من كارما التعليقات تتخطى الكابتشا."

#: r2/lib/live_config_admin.py:71
msgid "How old an account must be, in days, to create a vault (admins can always create one)."
msgstr "العمر الذي يجب أن يبلغه الحساب، بالأيام، لإنشاء خزنة (يمكن للمديرين دائمًا إنشاء واحدة)."

#: r2/lib/live_config_admin.py:74
msgid "Post karma needed to create a vault (this, or the comment karma below)."
msgstr "كارما المنشورات اللازمة لإنشاء خزنة (هذه، أو كارما التعليقات أدناه)."

#: r2/lib/live_config_admin.py:77
msgid "Comment karma needed to create a vault (this, or the post karma above)."
msgstr "كارما التعليقات اللازمة لإنشاء خزنة (هذه، أو كارما المنشورات أعلاه)."

#: r2/lib/live_config_admin.py:80
msgid "A notice in every page's sidebar. Blank: none."
msgstr "إشعار في الشريط الجانبي لكل صفحة. فارغ: لا شيء."

#: r2/lib/live_config_admin.py:82
msgid "Messages for the \"new here?\" bar shown to logged-out visitors, each in double quotes; one is picked at random. \" / \" splits a message into a heading and a smaller second line, e.g. \"Welcome! / Pick a few vaults to subscribe to.\""
msgstr "رسائل شريط \"جديد هنا؟\" الذي يظهر للزوار غير المسجلين، كل واحدة بين علامتي تنصيص مزدوجتين؛ تُختار واحدة عشوائيًا. \" / \" تقسم الرسالة إلى عنوان وسطر ثانٍ أصغر، مثل \"مرحبًا! / اختر بعض الخزنات للاشتراك فيها.\""

#: r2/lib/live_config_admin.py:87
msgid "A message in the info bar at the top of listings. For a site-wide banner, use the announcement on /admin/site instead."
msgstr "رسالة في شريط المعلومات أعلى القوائم. لشريط على مستوى الموقع، استخدم الإعلان في /admin/site بدلًا من ذلك."

#: r2/lib/live_config_admin.py:90
msgid "Vaults that help people find more vaults, for the explore tab: names, comma-separated."
msgstr "خزنات تساعد الناس على إيجاد خزنات أخرى، لتبويب الاستكشاف: أسماء مفصولة بفواصل."

#: r2/lib/live_config_admin.py:93
msgid "New API apps (registered on /prefs/apps) work only for their own developers until an admin approves them on /admin/apps."
msgstr "تطبيقات API الجديدة (المسجلة في /prefs/apps) تعمل فقط لمطوريها حتى يوافق عليها مدير في /admin/apps."

#: r2/lib/live_config_admin.py:96
msgid "How old an account must be, in days, to register an API app."
msgstr "العمر الذي يجب أن يبلغه الحساب، بالأيام، لتسجيل تطبيق API."

#: r2/lib/live_config_admin.py:98
msgid "Total karma (posts and comments) needed to register an API app."
msgstr "مجموع الكارما (المنشورات والتعليقات) اللازم لتسجيل تطبيق API."

#: r2/lib/live_config_admin.py:100
msgid "Whether registering an API app needs a verified email address."
msgstr "هل يحتاج تسجيل تطبيق API إلى عنوان بريد إلكتروني موثّق."

#: r2/lib/live_config_admin.py:102
msgid "New comments appear on a thread while people have it open, without reloading. When this is on, each vault's moderators choose whether their vault uses it (in the vault's settings), and each member whether they see it (in their preferences). Needs the websockets service (tippr-websockets) running."
msgstr ""

#: r2/lib/live_config_admin.py:108
