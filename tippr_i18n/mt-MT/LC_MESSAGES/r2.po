msgstr "L-aħħar rilaxx huwa"

#: r2/templates/adminserverstatus.html:47
#, python-format
msgid "an update is available for %(n)s of your servers"
msgstr "hemm aġġornament disponibbli għal %(n)s mis-servers tiegħek"

