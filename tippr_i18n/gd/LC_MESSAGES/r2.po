msgid "More vaults on your front page"
msgstr "Barrachd vaults air do phrìomh-dhuilleag"

#: r2/templates/goldabout.html:34
#, python-format
msgid "Your front page shows posts from up to %(gold)s of the vaults you subscribe to, instead of %(normal)s."
msgstr "Seallaidh do phrìomh-dhuilleag puist o suas gu %(gold)s dhe na vaults dhan do fho-sgrìobh thu, an àite %(normal)s."

