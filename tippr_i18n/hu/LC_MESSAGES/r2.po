msgstr "Még nincs fizetés."

#: r2/templates/adminpaymentsettings.html:240
msgid "what"
msgstr "mi"

#: r2/templates/adminpaymentsettings.html:241
msgid "buyer"
msgstr "vevő"

#: r2/templates/adminpaymentsettings.html:242
