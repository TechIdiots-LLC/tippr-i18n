msgstr "összeg"

#: r2/templates/adminpaymentsettings.html:243
msgid "provider"
msgstr "szolgáltató"

#: r2/templates/adminpaymentsettings.html:268 r2/templates/renderablecampaign.html:104
msgid "refund"
msgstr "visszatérítés"

#: r2/templates/adminpaymentsettings.html:269
msgid "Refund this payment in full and take back what it bought?"
msgstr "Visszatéríted ezt a fizetést teljes egészében, és visszaveszed, amit vettek vele?"

#: r2/templates/adminpaymentsettings.html:271
msgid "mark refunded"
msgstr "visszatérítettként jelölés"

#: r2/templates/adminpaymentsettings.html:272
