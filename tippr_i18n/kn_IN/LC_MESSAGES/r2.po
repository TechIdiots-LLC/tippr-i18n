msgstr "ಏನನ್ನು ಖರೀದಿಸಬಹುದು"

#: r2/templates/adminpaymentsettings.html:112
msgid "gold, Give Gold, gifts and gift codes"
msgstr "ಚಿನ್ನ, 'ಚಿನ್ನ ಕೊಡಿ', ಉಡುಗೊರೆಗಳು ಮತ್ತು ಉಡುಗೊರೆ ಕೋಡ್‌ಗಳು"

#: r2/templates/adminpaymentsettings.html:120
