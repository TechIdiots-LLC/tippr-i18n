msgstr "No he entendido tu consulta, así que la he simplificado y he buscado \"%(clean_query)s\" en su lugar."

#: r2/lib/strings.py:117
msgid "I couldn't understand your search query. Please try again."
msgstr "No he entendido tu consulta. Inténtalo de nuevo."

