msgstr "Зайти до моєї скриньки або відправити приватне повідомлення іншому користувачеві."

#: r2/models/token.py:231
msgid "Read Content"
msgstr "Читати Матеріал"

#: r2/models/token.py:232
msgid "Access posts and comments through my account."
msgstr "Доступ до матеріалів та коментарів через мій акаунт."

#: r2/models/token.py:236
msgid "Report content"
msgstr "Поскаржитись на вміст"

#: r2/models/token.py:237
msgid "Report content for rules violations. Hide & show individual submissions."
msgstr "Поскаржитись на вміст за порушення правил. Сховати або показати окремі публікації."

#: r2/models/token.py:242
msgid "Save Content"
msgstr "Зберегти Вміст"

#: r2/models/token.py:243
msgid "Save and unsave comments and submissions."
msgstr "Зберегти або забути коментарі та публікациї."

#: r2/models/token.py:247
msgid "Submit Content"
msgstr "Опублікувати Матеріал"

#: r2/models/token.py:248
msgid "Submit links and comments from my account."
msgstr "Публікувати посилання та коментарі через мій акаунт."

#: r2/models/token.py:252
msgid "Edit My Subscriptions"
msgstr "Редагувати Мої Підписки"

#: r2/models/token.py:253
msgid "Manage my vault subscriptions. Manage \"friends\" - users whose content I follow."
msgstr "Керування моїми підписками на волти. Керування «друзями» — користувачами, за чиїми публікаціями я слідкую."

#: r2/models/token.py:258
msgid "Vote"
msgstr "Голосувати"

#: r2/models/token.py:260
msgid "Submit and change my votes on comments and submissions."
msgstr "Опублікувати або змінити мої голоси віддані за коментарі та публікації."

#: r2/models/token.py:264
msgid "Wiki Editing"
msgstr "Редагування Вікі"

#: r2/models/token.py:265
msgid "Edit wiki pages on my behalf"
msgstr "Редагувати сторінки вікі з мого дозволу"

