msgid "Moderation Log"
msgstr "Лог Модерації"

#: r2/models/token.py:185
msgid "Access the moderation log in vaults I moderate."
msgstr "Доступ до логу модерації волтів у яких я модератор."

#: r2/models/token.py:189
