msgid "Moderate Vault Configuration"
msgstr "Модерація налаштувань Волту"

#: r2/models/token.py:178
msgid "Manage the configuration, sidebar, and CSS of vaults I moderate."
msgstr "Керувати конфігурацією, боковою панеллю та стилями CSS волтів, які я модерую."

