#: r2/models/token.py:206
msgid "Vault Traffic"
msgstr "Трафік Волту"

#: r2/models/token.py:207
msgid "Access traffic stats in vaults I moderate."
msgstr "Доступ до статистики трафіку в волтах, які я модерую."

#: r2/models/token.py:211
msgid "Moderate Wiki"
msgstr "Модерувати Вікі"

#: r2/models/token.py:213
msgid "Change editors and visibility of wiki pages in vaults I moderate."
msgstr "Змінити редактори та видимість сторінок вікі в волтах, які я модерую."

#: r2/models/token.py:218
msgid "My Vaults"
msgstr "Мої Волти"

#: r2/models/token.py:220
msgid "Access the list of vaults I moderate, contribute to, and subscribe to."
msgstr "Доступ до переліку волтів які я модерую, в які я пишу и на які я підписаний."

