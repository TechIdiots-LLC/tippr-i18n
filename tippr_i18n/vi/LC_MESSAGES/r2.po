msgstr "Tippr hiện đang ở \"chế độ chỉ đọc khẩn cấp\". :( Bạn sẽ chưa thể đăng nhập. Chúng tôi rất xin lỗi và đang khẩn trương khắc phục sự cố."

#: r2/lib/strings.py:122
msgid "this page is temporarily in read-only mode due to heavy traffic."
msgstr "trang này tạm thời ở chế độ chỉ đọc do lưu lượng truy cập cao."

#: r2/lib/strings.py:123
