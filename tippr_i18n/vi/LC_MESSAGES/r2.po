msgstr "bạn chưa theo dõi cộng đồng nào."

#: r2/lib/strings.py:92
msgid "you haven't chosen any vaults yet, so your front page shows the site's default vaults, below. subscribe or unsubscribe to make the list your own."
msgstr "bạn chưa chọn cộng đồng nào, vì vậy trang chính của bạn đang hiển thị các cộng đồng mặc định của trang ở bên dưới. bạn có thể theo dõi hoặc bỏ theo dõi để tạo danh sách của riêng mình."

