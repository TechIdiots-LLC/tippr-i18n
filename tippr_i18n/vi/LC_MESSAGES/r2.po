#: r2/templates/privacysettings.html:39
msgid "Download Your Data"
msgstr "Tải xuống dữ liệu của bạn"

#: r2/templates/privacysettings.html:40
msgid "You can request a copy of your personal data. This includes your posts, comments, messages, preferences, and other account information."
msgstr "Bạn có thể yêu cầu một bản sao dữ liệu cá nhân. Bản sao bao gồm bài đăng, bình luận, tin nhắn, cấu hình và các thông tin tài khoản khác của bạn."

#: r2/templates/privacysettings.html:43
msgid "A data export is currently being prepared. You will be notified when it is ready."
msgstr "Một bản xuất dữ liệu đang được chuẩn bị. Bạn sẽ được thông báo khi nó sẵn sàng."

#: r2/templates/privacysettings.html:46
msgid "Your data export is ready for download."
msgstr "Bản xuất dữ liệu của bạn đã sẵn sàng để tải xuống."

#: r2/templates/privacysettings.html:47
msgid "Download Export"
msgstr "Tải xuống bản xuất"

#: r2/templates/privacysettings.html:48
msgid "This download will expire in 7 days. Downloads are limited to 5 times."
msgstr "Liên kết tải xuống này hết hạn sau 7 ngày. Chỉ được tải tối đa 5 lần."

#: r2/templates/privacysettings.html:53
msgid "Request Data Export"
msgstr "Yêu cầu xuất dữ liệu"

#: r2/templates/privacysettings.html:56
msgid "Data exports are processed within 24-48 hours. You can request one export per day."
msgstr "Yêu cầu xuất dữ liệu được xử lý trong vòng 24-48 giờ. Bạn có thể yêu cầu một lần xuất mỗi ngày."

#: r2/templates/privacysettings.html:61
msgid "Export History"
msgstr "Lịch sử xuất"

#: r2/templates/privacysettings.html:64
msgid "Action"
msgstr "Hành động"

#: r2/templates/privacysettings.html:73
msgid "Download"
msgstr "Tải xuống"

#: r2/templates/privacysettings.html:78
msgid "Cancel"
msgstr "Hủy"

#: r2/templates/privacysettings.html:91
msgid "Your Privacy Rights"
msgstr "Quyền riêng tư của bạn"

#: r2/templates/privacysettings.html:92
msgid "Under privacy laws like GDPR and CCPA, you have the following rights:"
msgstr "Theo các luật về quyền riêng tư như GDPR và CCPA, bạn có các quyền sau:"

#: r2/templates/privacysettings.html:94
msgid "Right to Access"
msgstr "Quyền truy cập"

#: r2/templates/privacysettings.html:94
msgid "Request a copy of your personal data"
msgstr "Yêu cầu bản sao dữ liệu cá nhân của bạn"

#: r2/templates/privacysettings.html:95
msgid "Right to Deletion"
msgstr "Quyền xóa"

#: r2/templates/privacysettings.html:95
msgid "Delete your account and personal data"
msgstr "Xóa tài khoản và dữ liệu cá nhân của bạn"

#: r2/templates/privacysettings.html:96
msgid "Right to Portability"
msgstr "Quyền di chuyển dữ liệu"

#: r2/templates/privacysettings.html:96
msgid "Download your data in a portable format"
msgstr "Tải xuống dữ liệu của bạn ở định dạng dễ chuyển"

#: r2/templates/privacysettings.html:97
msgid "Right to Rectification"
msgstr "Quyền chỉnh sửa"

#: r2/templates/privacysettings.html:97
msgid "Correct inaccurate personal data"
msgstr "Sửa dữ liệu cá nhân không chính xác"

#: r2/templates/privacysettings.html:99
msgid "For more information, see our"
msgstr "Để biết thêm thông tin, hãy xem"

#: r2/templates/privacysettings.html:103
msgid "Delete Your Account"
msgstr "Xóa tài khoản của bạn"

#: r2/templates/privacysettings.html:104
msgid "You can permanently delete your account and all associated data. This action cannot be undone."
msgstr "Bạn có thể xóa vĩnh viễn tài khoản và mọi dữ liệu liên quan. Hành động này không thể hoàn tác."

#: r2/templates/privacysettings.html:106
msgid "Right away you're logged out everywhere, nobody can log in to the account, and the name can't be registered again."
msgstr "Ngay lập tức bạn bị đăng xuất ở mọi nơi, không ai đăng nhập được vào tài khoản, và tên này không thể đăng ký lại."

