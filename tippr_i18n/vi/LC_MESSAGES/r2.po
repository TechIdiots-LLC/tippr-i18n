msgid "This comment is not stickyable. Ensure that it is a top level comment."
msgstr "Không thể ghim bình luận này. Hãy chắc chắn đó là bình luận cấp cao nhất."

#: r2/lib/errors.py:203 r2/public/static/js/errors.js:7
