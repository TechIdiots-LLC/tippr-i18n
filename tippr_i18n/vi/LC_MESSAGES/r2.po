msgid "to convert an existing vault to gold only, send a message to %(admin_modmail)s"
msgstr "để chuyển đổi một chuyên mục sang dạng chỉ dành cho các thành viên vàng, hãy gửi một tin nhắn tới %(admin_modmail)s"

#: r2/lib/errors.py:194
msgid "this vault must be 'gold only' to select this"
msgstr "thư mục này chỉ dành cho các thành viên vàng"

