msgstr "vui lòng bật chế độ quản trị để thực hiện thao tác này"

#: r2/lib/errors.py:193
#, python-format
msgid "to convert an existing vault to gold only, send a message to %(admin_modmail)s"
msgstr "để chuyển một cộng đồng hiện có sang chế độ chỉ dành cho thành viên gold, vui lòng gửi tin nhắn đến %(admin_modmail)s"

#: r2/lib/errors.py:195
msgid "this vault must be 'gold only' to select this"
msgstr "cộng đồng cần ở chế độ 'chỉ dành cho thành viên gold' để chọn mục này"

#: r2/lib/errors.py:196
msgid "your account is too new or you do not have enough karma to create a vault. please contact the admins to request an exemption."
