msgstr "mở bảng điều khiển"

#: r2/templates/adminloginsettings.html:81
msgid "Instagram no longer offers sign-in for other sites; Facebook Login is Meta's."
msgstr "Instagram không còn cung cấp đăng nhập cho các trang khác; Facebook Login là của Meta."

