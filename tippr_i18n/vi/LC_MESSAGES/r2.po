#: r2/lib/errors.py:197
msgid "you must select at least one mobile OS to target"
msgstr "vui lòng chọn ít nhất một hệ điều hành di động để nhắm đến"

#: r2/lib/errors.py:198 r2/templates/promotelinkbase.html:524
msgid "you must select at least one device per OS to target"
msgstr "vui lòng chọn ít nhất một thiết bị cho mỗi hệ điều hành"

#: r2/lib/errors.py:199
msgid "You have been muted from this vault."
msgstr "Bạn đã bị tắt tiếng trong cộng đồng này."

#: r2/lib/errors.py:200
msgid "This user has been muted from the vault."
msgstr "Người dùng này đã bị tắt tiếng trong cộng đồng."

#: r2/lib/errors.py:201
msgid "please say how much AI went into this post"
msgstr "vui lòng cho biết mức độ sử dụng AI trong bài đăng này"

#: r2/lib/errors.py:202
#, python-format
msgid "this vault only accepts: %(allowed)s"
msgstr "cộng đồng này chỉ nhận: %(allowed)s"

#: r2/lib/errors.py:203
msgid "This comment is not stickyable. Ensure that it is a top level comment."
msgstr "Không thể ghim bình luận này. Vui lòng kiểm tra đây có phải là bình luận cấp cao nhất không."

#: r2/lib/errors.py:204 r2/public/static/js/errors.js:7
msgid "A vault rule by that name already exists."
msgstr "Đã có quy định của cộng đồng mang tên này."

#: r2/lib/errors.py:205
msgid "No vault rule by that name exists."
msgstr "Không có quy định nào của cộng đồng mang tên này."

