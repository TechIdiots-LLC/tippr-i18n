msgstr "Hãy đến [%(link)s](%(link)s) để biết thêm chi tiết"

#: r2/lib/strings.py:91
msgid "you have not subscribed to any vaults."
msgstr "bạn chưa đăng ký theo dõi chuyên mục nào."

#: r2/lib/strings.py:92
msgid "you haven't chosen any vaults yet, so your front page shows the site's default vaults, below. subscribe or unsubscribe to make the list your own."
msgstr "bạn chưa chọn chuyên mục nào, nên trang chủ của bạn hiển thị các chuyên mục mặc định của trang, bên dưới. hãy đăng ký hoặc hủy đăng ký để biến danh sách thành của riêng bạn."

#: r2/lib/strings.py:93
msgid "below are the vaults you have subscribed to."
msgstr "dưới đây là những chuyên mục bạn đã theo dõi."

#: r2/lib/strings.py:94
msgid "below are the vaults that you are an approved submitter on."
msgstr "bên dưới là các chuyên mục mà bạn được quyền đăng bài."

#: r2/lib/strings.py:95
msgid "below are the vaults that you have moderator access to."
msgstr "bên dưới là các chuyên mục bạn có quyền quản lý và điều hành."

#: r2/lib/strings.py:98
msgid "click the `subscribe` or `unsubscribe` buttons to choose which vaults appear on your front page."
msgstr "click nút `đăng ký` hoặc `hủy đăng ký` để chọn chuyên mục nào hiển thị trên trang chính của bạn."

#: r2/lib/strings.py:100
#, python-format
msgid "you're searching within the [%(vault_name)s](%(vault_link)s) vault. you can also search within [all vaults](%(all_vaults_link)s)"
msgstr "bạn đang tìm trong chuyên mục [%(vault_name)s](%(vault_link)s). bạn cũng có thể tìm trong [tất cả chuyên mục](%(all_vaults_link)s)"

#: r2/lib/strings.py:103
#, python-format
msgid "%(author)s comments on %(title)s"
msgstr "%(author)s bình luận trên %(title)s"

#: r2/lib/strings.py:104
#, python-format
msgid "%(title)s : %(site)s"
msgstr "%(title)s : %(site)s"

#: r2/lib/strings.py:105
#, python-format
msgid "%(score)s points and %(num_comments)s comments so far on tippr"
msgstr "%(score)s điểm và %(num_comments)s bình luận trên tippr"

#: r2/lib/strings.py:107
msgid "You are submitting a link. The key to a successful submission is interesting content and a descriptive title."
msgstr "Bạn đang đệ trình một đường dẫn liên kết. Để có thể đệ trình thành công thì nội dung bạn đệ trình cần thú vị và tiêu đề cần được miêu tả rõ ràng."

#: r2/lib/strings.py:108
msgid "You are submitting a text-based post. Speak your mind. A title is required, but expanding further in the text field is not. Beginning your title with \"vote up if\" is violation of intergalactic law."
msgstr "Bạn đang đệ trình một bài đăng-dựa trên văn bản. Hãy thể hiện tư tưởng của bản. Trong trường hợp này thì tiêu đề là điều cần thiết, nhưng có thể mở rộng ra hơn ở khung văn bản thì không. Bắt đầu tiêu đề của bạn dưới dạng \"bình chọn tăng nếu\" là hoàn toàn vi phạm luật định."

#: r2/lib/strings.py:109 r2/templates/listing.html:114
msgid "Submit a new link"
msgstr "Đăng một liên kết mới"

#: r2/lib/strings.py:110 r2/templates/listing.html:115
msgid "Submit a new text post"
msgstr "Đăng một bài văn bản mới"

#: r2/lib/strings.py:111
msgid "we're going to need to verify your email address for you to proceed."
msgstr "bạn cần phải xác nhận email của mình để có thể tiếp tục."

#: r2/lib/strings.py:112
msgid "you'll be able to submit more frequently once you verify your email address"
msgstr "bạn có thể đệ trình thường xuyên hơn nếu bạn xác nhận tài khoản email của mình"

#: r2/lib/strings.py:113
msgid "your email address has been verified"
msgstr "địa chỉ email của bạn đã được xác nhận"

#: r2/lib/strings.py:114
msgid "Verification failed.  Please try that again"
msgstr "Xác nhận thất bại. Xin thử lại một lần nữa"

#: r2/lib/strings.py:115
msgid "The email verification link you've followed is for a different user. Please log out and switch to that user or try again below."
msgstr "Liên kết xác minh email bạn vừa mở là của một người dùng khác. Vui lòng đăng xuất và chuyển sang người dùng đó hoặc thử lại bên dưới."

#: r2/lib/strings.py:116
msgid "Our search machines are under too much load to handle your request right now. :( Sorry for the inconvenience. Try again in a little bit -- but please don't mash reload; that only makes the problem worse."
msgstr "Hệ thống tìm kiếm của chúng tôi đang quá tải và không thể giải quyết yêu cầu của bạn bây giờ. :( Xin lỗi vì sự bất tiện này. Hãy thử lại sau một lát -- nhưng đừng tải lại quá nhiều; chỉ làm vấn đề tệ hơn thôi."

#: r2/lib/strings.py:117
#, python-format
msgid "I couldn't understand your query, so I simplified it and searched for \"%(clean_query)s\" instead."
msgstr "Tôi không hiểu truy vấn của bạn, bởi thế Tôi chỉ đơn giản hóa truy vấn đó và đã thực hiện việc tìm kiếm về \"%(clean_query)s\"."

#: r2/lib/strings.py:118
msgid "I couldn't understand your search query. Please try again."
msgstr "Tôi không thể hiểu truy vấn của bạn. Xin thử lại lần nữa."

#: r2/lib/strings.py:119
#, python-format
msgid "You may also want to check the [search help page](%(search_help)s) for more information."
msgstr "Có thể bạn cũng muốn xem [trang trợ giúp tìm kiếm](%(search_help)s) để biết thêm thông tin."

#: r2/lib/strings.py:120
msgid "tippr uses a slightly-customized version of [Markdown](http://daringfireball.net/projects/markdown/syntax) for formatting. See below for some basics, or check [the formatting help](/help/formatting) for more detailed help and solutions to common issues."
msgstr "tippr dùng một phiên bản [Markdown](http://daringfireball.net/projects/markdown/syntax) được tùy chỉnh đôi chút để định dạng. Xem bên dưới để biết vài điều cơ bản, hoặc xem [trợ giúp định dạng](/help/formatting) để có hướng dẫn chi tiết hơn và cách giải quyết các vấn đề thường gặp."

#: r2/lib/strings.py:121
msgid "Tippr is in \"emergency read-only mode\" right now. :( You won't be able to log in. We're sorry and are working frantically to fix the problem."
msgstr "Tippr hiện đang ở \"chế độ chỉ đọc khẩn cấp\". :( Bạn sẽ không thể đăng nhập. Chúng tôi rất xin lỗi và đang gấp rút khắc phục sự cố."

#: r2/lib/strings.py:122
msgid "this page is temporarily in read-only mode due to heavy traffic."
msgstr "trang này đang tạm thời ở chế độ đọc vì quá tải."

#: r2/lib/strings.py:123
msgid "Your account is in a [timeout](/help/suspensions) until the site's staff lift it."
msgstr "Tài khoản của bạn đang bị [tạm khóa](/help/suspensions) cho đến khi nhân viên của trang gỡ bỏ."

#: r2/lib/strings.py:124
#, python-format
msgid "Your account is in a [timeout](/help/suspensions) for %(days)s."
msgstr "Tài khoản của bạn đang bị [tạm khóa](/help/suspensions) trong %(days)s."

#: r2/lib/strings.py:127
msgid "You sent us a postcard! (Or something similar.) When we run out of room on our refrigerator, we might one day auction off the stuff that people sent in. Is it okay if we include your thing?"
msgstr "Bạn có thể gửi cho chúng tôi bưu thiếp đấy! (Hoặc thứ gì đó tương tự). Khi chúng tôi đã hết phòng chứa các vật liệu gửi tặng từ thành viên hoặc đơn giản là tủ lạnh của chúng tôi đã chật ních các đồ, thì một ngày nào đó các vật phẩm này sẽ được mang đi bán đấu giá. Liệu có ổn không nếu chúng tôi cũng đấu giá các đồ vật này từ bạn?"

#: r2/lib/strings.py:128
#, python-format
msgid "Sorry, the maximum number of comments is %(max)d. (However, if you subscribe to tippr gold, it goes up to %(goldmax)d.)"
msgstr "Rất xin lỗi, số lượng bình luận tối đa là %(max)d. (Tuy nhiên, nếu bạn đăng ký theo dõi dưới dạng tippr gold, thì số lượng bình luận sẽ lên tới %(goldmax)d.)"

#: r2/lib/strings.py:129
#, python-format
msgid "Sorry, the maximum number of comments is %d."
msgstr "Xin lỗi, số lượng bình luận tối đa là %d."

