msgstr "tài khoản của bạn quá mới hoặc chưa đủ karma để tạo chuyên mục. vui lòng liên hệ quản trị viên để xin ngoại lệ."

#: r2/lib/errors.py:196
msgid "you must select at least one mobile OS to target"
msgstr "bạn cần chọn ít nhất một hệ điều hành di động để trỏ tới"

#: r2/lib/errors.py:197 r2/templates/promotelinkbase.html:524
msgid "you must select at least one device per OS to target"
msgstr "bạn phải chọn ít nhất một thiết bị cho mỗi hệ điều hành để nhắm đến"

#: r2/lib/errors.py:198
msgid "You have been muted from this vault."
msgstr "Bạn đã bị tắt tiếng trong chuyên mục này."

#: r2/lib/errors.py:199
msgid "This user has been muted from the vault."
msgstr "Người dùng này đã bị tắt tiếng trong chuyên mục."

#: r2/lib/errors.py:200
msgid "please say how much AI went into this post"
msgstr "vui lòng cho biết bài đăng này dùng AI đến mức nào"

#: r2/lib/errors.py:201
#, python-format
msgid "this vault only accepts: %(allowed)s"
msgstr "chuyên mục này chỉ chấp nhận: %(allowed)s"

