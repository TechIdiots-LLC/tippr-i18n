#: r2/templates/adminserverstatus.html:25
msgid "Each server reports its state here once a minute (tippr-job-server_status). Only the latest report is kept; a server that stops reporting is flagged after 3 minutes and dropped after 7 days, or forget it below once it's out of service."
msgstr "Setiap server melaporkan kondisinya di sini sekali semenit (tippr-job-server_status). Hanya laporan terbaru yang disimpan; server yang berhenti melapor ditandai setelah 3 menit dan dihapus setelah 7 hari, atau lupakan di bawah setelah server tidak dipakai lagi."

#: r2/templates/adminserverstatus.html:28
msgid "No server has reported yet. Reports start within a minute of installing or upgrading (the tippr-job-server_status timer)."
msgstr "Belum ada server yang melapor. Laporan dimulai dalam satu menit setelah pemasangan atau peningkatan (timer tippr-job-server_status)."

#: r2/templates/adminserverstatus.html:33
msgid "updates"
msgstr "pembaruan"

#: r2/templates/adminserverstatus.html:35
#, python-format
msgid "GitHub couldn't be asked about releases (%(error)s); trying again in a few minutes."
msgstr "GitHub tidak bisa ditanyai soal rilis (%(error)s); mencoba lagi dalam beberapa menit."

#: r2/templates/adminserverstatus.html:37
#, python-format
msgid "No release of %(repo)s has an installer yet."
msgstr "Belum ada rilis %(repo)s yang punya installer."

#: r2/templates/adminserverstatus.html:40
msgid "The newest release is"
msgstr "Rilis terbaru adalah"

#: r2/templates/adminserverstatus.html:47
#, python-format
msgid "an update is available for %(n)s of your servers"
msgstr "pembaruan tersedia untuk %(n)s server-mu"

#: r2/templates/adminserverstatus.html:49
